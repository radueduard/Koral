+        // (Through XGetVisualInfo, which GLFW has loaded: it links nothing of Xlib's.)
+        XVisualInfo wanted = { 0 };
+        wanted.screen = _glfw.x11.screen;
+        wanted.depth = 32;
+        wanted.class = TrueColor;
+        int count = 0;
+        XVisualInfo* found = XGetVisualInfo(_glfw.x11.display,
+                                            VisualScreenMask | VisualDepthMask | VisualClassMask,
+                                            &wanted, &count);
+        for (int i = 0; found && i < count; i++)
+        {
+            if (!_glfwIsVisualTransparentX11(found[i].visual))
+                continue;
+            visual = found[i].visual;
+            depth = found[i].depth;
+            break;
+        }
+        if (found)
+            XFree(found);
+    }
