+// Koral: the compositor is asked to move the window, or (with edges, an XDG_TOPLEVEL_RESIZE_EDGE_*)
+// to resize it, by the press that is still down — what a window that draws its own title bar and
+// edges needs, and GLFW has no call for. The compositor takes the pointer from here, so the window
+// is told the button is up: its real release is never heard of.
+GLFWAPI void glfwKoralWaylandMoveResize(GLFWwindow* handle, int edges)
+{
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    struct xdg_toplevel* toplevel;
+
+    if (!_glfw.initialized || !window || _glfw.platform.platformID != GLFW_PLATFORM_WAYLAND)
+        return;
+
+    toplevel = window->wl.xdg.toplevel;
+    if (window->wl.libdecor.frame)
+        toplevel = libdecor_frame_get_xdg_toplevel(window->wl.libdecor.frame);
+    if (!toplevel || !_glfw.wl.seat)
+        return;
+
+    if (edges < 0)
+        xdg_toplevel_move(toplevel, _glfw.wl.seat, _glfw.wl.serial);
+    else
+        xdg_toplevel_resize(toplevel, _glfw.wl.seat, _glfw.wl.serial, (uint32_t) edges);
+
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE, 0);
+}
+
 #endif // _GLFW_WAYLAND
 
